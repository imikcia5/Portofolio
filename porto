<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio - Danastri Ataya Delisia</title>
    <style>
        /* Reset & Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0f172a;
            color: #f8fafc;
            line-height: 1.6;
            padding-bottom: 50px;
        }

        /* Navbar */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            background-color: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid #1e293b;
            z-index: 1000;
        }

        nav {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
        }

        .logo {
            font-weight: bold;
            font-size: 1.2rem;
            color: #38bdf8;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 1.5rem;
        }

        nav a {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #38bdf8;
        }

        /* Container Sections */
        section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 6rem 2rem 2rem 2rem;
        }

        h2.section-title {
            font-size: 2rem;
            color: #38bdf8;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #1e293b;
            padding-bottom: 0.5rem;
        }

        /* Hero / About Me Section */
        .hero {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .hero h1 {
            font-size: 2.5rem;
            line-height: 1.2;
        }

        .hero span {
            color: #38bdf8;
        }

        .tagline {
            font-size: 1.2rem;
            color: #94a3b8;
            font-weight: 500;
        }

        .meta-info {
            background-color: #1e293b;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            display: inline-block;
            margin-top: 0.5rem;
        }

        .meta-info p {
            margin-bottom: 0.3rem;
            color: #cbd5e1;
        }

        .activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .activity-card {
            background-color: #1e293b;
            padding: 1rem;
            border-radius: 8px;
            border-left: 4px solid #38bdf8;
        }

        /* What I Can Do Section */
        .capabilities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .card {
            background-color: #1e293b;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #334155;
        }

        .card h3 {
            color: #f1f5f9;
            margin-bottom: 0.8rem;
        }

        .skills-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .skill-badge {
            background-color: #0284c7;
            color: #fff;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        /* Achievement Section */
        .achievement-card {
            background-color: #1e293b;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            border: 1px solid #334155;
        }

        .achievement-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .achievement-title {
            font-size: 1.1rem;
            font-weight: bold;
            color: #f1f5f9;
        }

        .achievement-year {
            background-color: #334155;
            color: #38bdf8;
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.85rem;
        }

        .organizer {
            font-size: 0.9rem;
            color: #94a3b8;
            margin-bottom: 0.5rem;
        }

        /* Contact Section */
        .contact-links {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 500px;
        }

        .contact-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #1e293b;
            color: #f8fafc;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid #334155;
            transition: all 0.3s;
        }

        .contact-btn:hover {
            background-color: #0284c7;
            border-color: #38bdf8;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 2rem;
            color: #64748b;
            font-size: 0.85rem;
            border-top: 1px solid #1e293b;
            margin-top: 4rem;
        }

        /* Responsive Navbar */
        @media (max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>
</head>
